# Copie este arquivo para .env e preencha os valores.
# O arquivo .env NUNCA vai para o GitHub (está no .gitignore).

# Ambiente: development | staging | production
APP_ENV=development

# Supabase (Project Settings → API). Preencha quando o projeto existir.
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Chave de serviço: só no backend, nunca no frontend.
SUPABASE_SERVICE_ROLE_KEY=

# Banco local para desenvolvimento (docker-compose)
DATABASE_URL=postgresql://jobfinder:jobfinder@localhost:5432/jobfinder
REDIS_URL=redis://localhost:6379/0

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000

# Anthropic (console.anthropic.com → API Keys). Só no backend: a análise do currículo.
ANTHROPIC_API_KEY=

# Adzuna (developer.adzuna.com → API access details). Só no backend: busca de vagas.
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
